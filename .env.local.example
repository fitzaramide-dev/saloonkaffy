# ====================================================================
# KAFFY SALOON — ENVIRONMENT CONFIGURATION
# Copy these values into your .env.local file
# ====================================================================

# --- CLERK AUTHENTICATION ---
# Find in Clerk Dashboard -> API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key
CLERK_SECRET_KEY=sk_test_your_clerk_secret_key

# Clerk Redirect Routes
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/portal
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/portal

# --- SUPABASE DATABASE ---
# Find in Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# --- RESEND EMAIL NOTIFICATIONS ---
# Find in Resend Dashboard -> API Keys
RESEND_API_KEY=re_your_resend_api_key

# Salon Admin Notifications
SALON_ADMIN_EMAIL=fitzaramide@gmail.com
RESEND_FROM_EMAIL=Kaffy Saloon <onboarding@resend.dev>
